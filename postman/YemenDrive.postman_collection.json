          "name": "Add Service Kind",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"ServiceKindModel\",\n  \"operation\": \"add\",\n  \"data\": {\n    \"code\": \"TRANSPORT\",\n    \"nameAr\": \"النقل\",\n    \"imageUrl\": \"\",\n    \"isActive\": true,\n    \"sortOrder\": 1\n  }\n}"
            },
            "url": "{{baseUrl}}/api/execute"
          },
          "event": [
            {
              "listen": "test",
              "script": {
