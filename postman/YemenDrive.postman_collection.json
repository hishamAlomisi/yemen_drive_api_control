{
  "info": {
    "name": "YemenDrive API",
    "description": "اختبار قاعدة YemenDrive والأنواع والخدمات الديناميكية والمصادقة وعمليات العميل والإدارة. نفذ الطلبات بالترتيب.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5080"
    },
    {
      "key": "dbServer",
      "value": ".\\\\sql2008r2"
    },
    {
      "key": "dbName",
      "value": "YemenDrive_Test"
    },
    {
      "key": "dbUsername",
      "value": "sa"
    },
    {
      "key": "dbPassword",
      "value": ""
    },
    {
      "key": "authToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "driverUserId",
      "value": ""
    },
    {
      "key": "driverProfileId",
      "value": ""
    },
    {
      "key": "serviceKindId",
      "value": ""
    },
    {
      "key": "serviceCatalogId",
      "value": ""
    },
    {
      "key": "pricingRuleId",
      "value": ""
    },
    {
      "key": "rideId",
      "value": ""
    },
    {
      "key": "rideIdempotencyKey",
      "value": "ride-test-001"
    },
    {
      "key": "paymentIdempotencyKey",
      "value": "cash-payment-test-001"
    },
    {
      "key": "rideOfferId",
      "value": ""
    },
    {
      "key": "savedPlaceId",
      "value": ""
    },
    {
      "key": "otpCode",
      "value": ""
    },
    {
      "key": "verificationToken",
      "value": ""
    },
    {
      "key": "signupChallengeId",
      "value": ""
    },
    {
      "key": "driverAuthToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Database",
      "item": [
        {
          "name": "Current Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/setup/database"
          }
        },
        {
          "name": "Create Database And 22 Tables",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider\": \"SqlServer\",\n  \"server\": \"{{dbServer}}\",\n  \"database\": \"{{dbName}}\",\n  \"username\": \"{{dbUsername}}\",\n  \"password\": \"{{dbPassword}}\",\n  \"integratedSecurity\": false,\n  \"trustServerCertificate\": true,\n  \"encrypt\": false,\n  \"recreateSchema\": true\n}"
            },
            "url": "{{baseUrl}}/api/setup/database/create"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Database and tables created', () => pm.expect(body.success).to.eql(true));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01.5 - Authentication",
      "item": [
        {
          "name": "Request Signup OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"777000010\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register/request-otp"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Signup OTP requested', () => pm.expect(body.success).to.eql(true));",
                  "if (body.success && body.data?.challengeId) pm.collectionVariables.set('signupChallengeId', body.data.challengeId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify Signup OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"destination\": \"777000010\",\n  \"code\": {{otpCode}},\n  \"purpose\": \"signUp\",\n  \"challengeId\": {{signupChallengeId}}\n}"
            },
            "url": "{{baseUrl}}/api/auth/verify-otp"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Signup OTP verified', () => pm.expect(body.success).to.eql(true));",
                  "if (body.success && body.data?.verificationToken) pm.collectionVariables.set('verificationToken', body.data.verificationToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Complete Customer Registration",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"777000010\",\n  \"displayName\": \"Flutter Test Customer\",\n  \"password\": \"Test1234\",\n  \"gender\": \"\",\n  \"street\": \"Hadda\",\n  \"city\": \"Sanaa\",\n  \"district\": \"وسط المدينة\",\n  \"verificationToken\": {{verificationToken}}\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Registration completed', () => pm.expect(body.success).to.eql(true));",
                  "if (body.success && body.data?.accessToken) pm.collectionVariables.set('authToken', body.data.accessToken);",
                  "pm.test('Authenticated user id returned', () => pm.expect(body.data?.user?.id).to.exist);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"777000010\",\n  \"password\": \"Test1234\",\n  \"deviceId\": \"postman-device\",\n  \"isTrustedDevice\": true\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Login response received', () => pm.expect(body.success).to.eql(true));",
                  "if (body.success && body.data?.accessToken) pm.collectionVariables.set('authToken', body.data.accessToken);",
                  "pm.test('Authenticated user id returned', () => pm.expect(body.data?.user?.id).to.exist);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
