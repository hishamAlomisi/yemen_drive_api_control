            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{driverAuthToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"RideModel\",\n  \"operation\": \"update\",\n  \"data\": {\n    \"id\": {{rideId}},\n    \"status\": 4\n  }\n}"
            },
            "url": "{{baseUrl}}/api/execute"
          }
        },
        {
          "name": "Start Ride",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{driverAuthToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"RideModel\",\n  \"operation\": \"update\",\n  \"data\": {\n    \"id\": {{rideId}},\n    \"status\": 5\n  }\n}"
            },
            "url": "{{baseUrl}}/api/execute"
          }
        },
        {
          "name": "Publish Customer Ride Location",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"RideLocationModel\",\n  \"operation\": \"add\",\n  \"data\": {\n    \"rideId\": {{rideId}},\n    \"latitude\": 15.3694,\n    \"longitude\": 44.1910,\n    \"bearing\": 90,\n    \"speed\": 4\n  }\n}"
            },
            "url": "{{baseUrl}}/api/execute"
          }
        },
        {
          "name": "Complete Ride (before payment)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{driverAuthToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"RideModel\",\n  \"operation\": \"update\",\n  \"data\": {\n    \"id\": {{rideId}},\n    \"status\": 6\n  }\n}"
            },
            "url": "{{baseUrl}}/api/execute"
          }
        },
        {
          "name": "Get Ride With Offers",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"RideModel\",\n  \"operation\": \"get\",\n  \"data\": { \"id\": {{rideId}} }\n}"
            },
            "url": "{{baseUrl}}/api/execute"
          }
        },
        {
          "name": "Get Customer Ride History",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
