            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"RideModel\",\n  \"operation\": \"update\",\n  \"data\": {\n    \"id\": {{rideId}},\n    \"status\": 4\n  }\n}"
            },
            "url": "{{baseUrl}}/api/execute"
          }
        },
        {
          "name": "Driver En Route",
