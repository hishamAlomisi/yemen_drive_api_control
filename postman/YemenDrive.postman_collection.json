              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"ServiceCatalogModel\",\n  \"operation\": \"add\",\n  \"data\": {\n    \"code\": \"CITY\",\n    \"nameAr\": \"خدمة نقل داخل المدينة\",\n    \"serviceKindId\": {{serviceKindId}},\n    \"arrivalMinutes\": 5,\n    \"basePrice\": 500,\n    \"rating\": 5,\n    \"seats\": 4,\n    \"descriptionAr\": \"خدمة نقل داخل المدينة\",\n    \"imageUrl\": \"\",\n    \"isRecommended\": true,\n    \"isActive\": true,\n    \"sortOrder\": 1\n  }\n}"
            },
            "url": "{{baseUrl}}/api/execute"
          },
          "event": [
            {
              "listen": "test",
