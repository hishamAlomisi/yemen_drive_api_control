            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"RideOfferActionModel\",\n  \"operation\": \"accept\",\n  \"data\": {\n    \"rideId\": {{rideId}},\n    \"offerId\": {{rideOfferId}}\n  }\n}"
            },
            "url": "{{baseUrl}}/api/execute"
          }
        },
        {
          "name": "Customer Cannot Set Driver Status",
          "description": "يستخدم رمز العميل الافتراضي. يجب أن يفشل الطلب لأن الحالة التشغيلية متاحة للسائق المسند فقط.",
