    {
      "name": "05 - Ride",
      "item": [
        {
          "name": "Add Ride",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"RideModel\",\n  \"operation\": \"add\",\n  \"data\": {\n    \"serviceKindId\": {{serviceKindId}},\n    \"serviceCatalogItemId\": {{serviceCatalogId}},\n    \n    \"pickupLabel\": \"Home\",\n    \"pickupAddress\": \"Sanaa - Hadda\",\n    \"pickupLatitude\": 15.3694,\n    \"pickupLongitude\": 44.1910,\n    \"destinationLabel\": \"Office\",\n    \"destinationAddress\": \"Sanaa - Tahrir\",\n    \"destinationLatitude\": 15.3547,\n    \"destinationLongitude\": 44.2067,\n    \"customerPrice\": 1750,\n    \"idempotencyKey\": \"{{rideIdempotencyKey}}\"\n  }\n}"
            },
            "url": "{{baseUrl}}/api/execute"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Ride created', () => pm.expect(body.success).to.eql(true));",
                  "if (body.success) pm.collectionVariables.set('rideId', body.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Retry Same Ride Request (idempotency)",
          "description": "شغّل هذا الطلب بعد Add Ride من دون تغيير rideIdempotencyKey. يجب أن يعيد API الرحلة نفسها ولا ينشئ رحلة ثانية.",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{driverAuthToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"RideModel\",\n  \"operation\": \"add\",\n  \"data\": {\n    \"serviceKindId\": {{serviceKindId}},\n    \"serviceCatalogItemId\": {{serviceCatalogId}},\n    \"pickupLabel\": \"Home\",\n    \"pickupAddress\": \"Sanaa - Hadda\",\n    \"pickupLatitude\": 15.3694,\n    \"pickupLongitude\": 44.1910,\n    \"destinationLabel\": \"Office\",\n    \"destinationAddress\": \"Sanaa - Tahrir\",\n    \"destinationLatitude\": 15.3547,\n    \"destinationLongitude\": 44.2067,\n    \"customerPrice\": 1750,\n    \"idempotencyKey\": \"{{rideIdempotencyKey}}\"\n  }\n}"
            },
            "url": "{{baseUrl}}/api/execute"
          }
        },
        {
          "name": "Start Safety Recording (explicit consent)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"SafetyRecordingModel\",\n  \"operation\": \"add\",\n  \"data\": {\n    \"rideId\": {{rideId}},\n    \"consent\": true\n  }\n}"
            },
            "url": "{{baseUrl}}/api/execute"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.success) pm.collectionVariables.set('safetyRecordingId', body.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Complete Safety Recording",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"durationMilliseconds\": 3000\n}"
            },
            "url": "{{baseUrl}}/api/safety/recordings/{{safetyRecordingId}}/complete"
          }
        },
        {
          "name": "Add Driver Offer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{driverAuthToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"RideOfferModel\",\n  \"operation\": \"add\",\n  \"data\": {\n    \"rideId\": {{rideId}},\n    \"driverId\": {{driverUserId}},\n    \"amount\": 1650,\n    \"validForSeconds\": 60,\n    \"note\": \"عرض تجريبي\"\n  }\n}"
            },
            "url": "{{baseUrl}}/api/execute"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
