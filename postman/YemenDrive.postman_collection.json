            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"UserModel\",\n  \"operation\": \"get\",\n  \"data\": {}\n}"
            },
            "url": "{{baseUrl}}/api/execute"
          }
        }
      ]
    },
    {
      "name": "03 - Driver",
      "item": [
        {
          "name": "Add Driver Profile",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"DriverModel\",\n  \"operation\": \"add\",\n  \"data\": {\n    \"userId\": {{driverUserId}},\n    \n    \"serviceKindId\": {{serviceKindId}},\n    \"serviceCatalogItemId\": {{serviceCatalogId}},\n    \"vehicleModel\": \"Toyota Yaris\",\n    \"plateNumber\": \"TEST-001\",\n    \"commissionRate\": 0.20,\n    \"isAvailable\": true,\n    \"rating\": 5\n  }\n}"
            },
            "url": "{{baseUrl}}/api/execute"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Driver profile created', () => pm.expect(body.success).to.eql(true));",
                  "if (body.success) pm.collectionVariables.set('driverProfileId', body.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Driver Location",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"DriverLocationModel\",\n  \"operation\": \"update\",\n  \"data\": {\n    \"driverId\": {{driverUserId}},\n    \"latitude\": 15.3694,\n    \"longitude\": 44.1910,\n    \"bearing\": 90,\n    \"speed\": 20,\n    \"isOnline\": true\n  }\n}"
            },
            "url": "{{baseUrl}}/api/execute"
          }
        }
      ]
    },
    {
      "name": "04 - Catalog And Pricing",
