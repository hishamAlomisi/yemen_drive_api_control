    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>yemendrive-api-development-maps</UserSecretsId>
    <DefaultItemExcludes>$(DefaultItemExcludes);buildcheck*/**;**/buildcheck*/**</DefaultItemExcludes>
  </PropertyGroup>

</Project>
