<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\YemenDrive.Shared\YemenDrive.Shared.csproj" />
    <ProjectReference Include="..\YemenDrive.Services\YemenDrive.Services.csproj" />
    <ProjectReference Include="..\YemenDrive.Database\YemenDrive.Database.csproj" />
    <ProjectReference Include="..\YemenDrive.Application\YemenDrive.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FirebaseAdmin" Version="3.7.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="lib\eqsWallets\eqsWallets*.dll">
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="run-api-with-console-otp.bat" CopyToPublishDirectory="PreserveNewest" />
    <!-- Keep browser dependencies inside this project's web root. A sibling
         repository-level wwwroot is not part of Web SDK publication. -->
    <Content Update="wwwroot\vendor\**\*"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <AdminVendorAsset Include="wwwroot\vendor\signalr\signalr.min.js" />
    <AdminVendorAsset Include="wwwroot\vendor\signalr\signalr.min.js.map" />
    <AdminVendorAsset Include="wwwroot\vendor\signalr\THIRD-PARTY-NOTICE.txt" />
    <AdminVendorAsset Include="wwwroot\vendor\leaflet\leaflet.js" />
    <AdminVendorAsset Include="wwwroot\vendor\leaflet\leaflet.js.map" />
    <AdminVendorAsset Include="wwwroot\vendor\leaflet\leaflet.css" />
    <AdminVendorAsset Include="wwwroot\vendor\leaflet\LICENSE" />
    <AdminVendorAsset Include="wwwroot\vendor\leaflet\images\layers.png" />
    <AdminVendorAsset Include="wwwroot\vendor\leaflet\images\layers-2x.png" />
    <AdminVendorAsset Include="wwwroot\vendor\leaflet\images\marker-icon.png" />
    <AdminVendorAsset Include="wwwroot\vendor\leaflet\images\marker-icon-2x.png" />
    <AdminVendorAsset Include="wwwroot\vendor\leaflet\images\marker-shadow.png" />
  </ItemGroup>

  <Target Name="ValidateAdminVendorAssets" BeforeTargets="PrepareForBuild;ComputeFilesToPublish">
    <Error Condition="!Exists('%(AdminVendorAsset.FullPath)')"
           Text="Missing admin vendor asset: %(AdminVendorAsset.Identity). Restore the pinned files in this project's wwwroot/vendor before publishing." />
  </Target>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>yemendrive-api-development-maps</UserSecretsId>
    <DefaultItemExcludes>$(DefaultItemExcludes);buildcheck*/**;**/buildcheck*/**</DefaultItemExcludes>
  </PropertyGroup>

</Project>
